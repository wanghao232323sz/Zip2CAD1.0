{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "exchange_dir", "media", "mode"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "exchange_dir": {"type": "string", "minLength": 1},
    "mode": {"enum": ["audit", "assisted"]},
    "reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["python_executable", "zipmap_repo", "checkpoint", "mode"],
      "properties": {
        "python_executable": {"type": "string", "minLength": 1},
        "zipmap_repo": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "mode": {"enum": ["smoke", "full"]},
        "max_frames": {"type": "integer", "minimum": 3, "maximum": 32}
      }
    },
    "media_processing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sample_fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "min_sharpness": {"type": "number", "minimum": 0},
        "min_frame_difference": {"type": "number", "minimum": 0, "maximum": 1},
        "block_size": {"type": "integer", "minimum": 3, "maximum": 120},
        "block_overlap": {"type": "integer", "minimum": 0},
        "min_short_side_px": {"type": "integer", "minimum": 64}
      }
    },
    "preparation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "roi_margin_m": {"type": "number", "minimum": 0, "maximum": 1000},
        "merge_tolerance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01},
        "min_triangle_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "horizontal_normal_z": {"type": "number", "minimum": 0, "maximum": 1},
        "vertical_normal_z": {"type": "number", "minimum": 0, "maximum": 1},
        "ground_quantile": {"type": "number", "minimum": 0, "maximum": 1},
        "roof_height_m": {"type": "number", "minimum": 0},
        "roi_seed_height_m": {"type": "number", "minimum": 0},
        "roi_quantile": {"type": "number", "minimum": 0, "maximum": 0.49},
        "min_plane_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "min_wall_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "min_wall_height_m": {"type": "number", "minimum": 0},
        "plane_normal_bin": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "plane_offset_bin_m": {"type": "number", "exclusiveMinimum": 0},
        "plane_merge_gap_m": {"type": "number", "minimum": 0},
        "parallel_angle_deg": {"type": "number", "minimum": 0, "maximum": 90},
        "perpendicular_angle_deg": {"type": "number", "minimum": 0, "maximum": 90},
        "coplanar_distance_m": {"type": "number", "minimum": 0},
        "connection_distance_m": {"type": "number", "minimum": 0},
        "max_constraint_pair_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "constraint_neighbors": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["images_dir", "video_file"],
      "properties": {
        "images_dir": {"type": ["string", "null"], "minLength": 1},
        "video_file": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "degenerate_policy": {"enum": ["reject", "exclude_from_analysis"]},
        "max_removed_fraction": {"type": "number", "minimum": 0, "maximum": 0.01},
        "max_removed_area_m2": {"type": "number", "minimum": 0, "maximum": 1e-8},
        "min_usable_views": {"type": "integer", "minimum": 3},
        "min_short_side_px": {"type": "integer", "minimum": 64},
        "min_sharpness": {"type": "number", "minimum": 0},
        "video_sample_count": {"type": "integer", "minimum": 3, "maximum": 120},
        "min_model_extent_m": {"type": "number", "exclusiveMinimum": 0},
        "max_model_extent_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
